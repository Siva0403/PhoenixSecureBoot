                    "ignoreFailures": false
                },
                {
                    "description": "Stop at main function",
                    "text": "break main",
                    "ignoreFailures": true
                },
                {
                    "description": "Continue to main",
                    "text": "continue",
                    "ignoreFailures": true
                }
            ],
