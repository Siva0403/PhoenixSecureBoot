{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "description": "Default build for STM32F411xE -Black Pill",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/arm-none-eabi.cmake",
        "CMAKE_BUILD_TYPE": "Release"
      },
      "binaryDir": "${sourceDir}/build"
    },
    {
      "name": "debug",
      "description": "Debug build with symbols for STM32F411xE",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/arm-none-eabi.cmake",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS": "-g3 -O0"
      },
      "binaryDir": "${sourceDir}/build_debug"
    },
    {
      "name": "release",
      "description": "Release build with optimizations for STM32F411xE",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/arm-none-eabi.cmake",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_FLAGS": "-O2"
      },
      "binaryDir": "${sourceDir}/build_release"
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "inheritConfigureEnvironment": true,
      "jobs": 4
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "inheritConfigureEnvironment": true
    },
    {
      "name": "release",
      "configurePreset": "release",
      "inheritConfigureEnvironment": true,
      "jobs": 4
    }
  ]
}
